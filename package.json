{
  "name": "ritmo-digital",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/sync-environments.mjs local && ng serve",
    "build": "node scripts/sync-environments.mjs production && ng build --configuration production",
    "build:development": "node scripts/sync-environments.mjs local && ng build --configuration development",
    "watch": "node scripts/sync-environments.mjs local && ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "firebase": "^12.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
